{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "hugo",
  "buildCommand": "hugo --gc --minify",
  "outputDirectory": "public",
  "functions": {
    "api/**/*.mjs": {
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/api/notion-webhook",
      "dest": "/api/notion-webhook.mjs"
    },
    {
      "src": "/.*",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
